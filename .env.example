# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: some Compose versions treat text after a value as part of it.

# Mode: offline (no credentials) or live (QBO + Stripe sandboxes)
MODE=offline
# Frozen reconciliation date for the public demo
RECON_AS_OF=2026-11-30
FIRST_RUN_AS_OF=2026-11-25
SYNC_DELAY_DAYS=2
CANDIDATE_DATE_TOLERANCE_DAYS=3
STALE_AFTER_DAYS=2
# Data the offline pipeline serves. fixtures/live_snapshot = real API responses captured
# from the QBO and Stripe sandboxes (no tokens needed at view time).
# Remove this line to use the generated fixtures in fixtures/offline instead.
FIXTURE_DIR=fixtures/live_snapshot
GITHUB_URL=https://github.com/jjeong4335/finrecon

# Docker / PostgreSQL
POSTGRES_PASSWORD=change-me-owner
DASHBOARD_DB_PASSWORD=change-me-readonly
# DNS name pointing at the server (use :80 for plain HTTP while testing)
DOMAIN=demo.example.com

# Live mode only
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
# File holding {"refresh_token": "..."}; rotated tokens are written back
QBO_TOKEN_FILE=.secrets/qbo_tokens.json
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# Test keys only (sk_test_...); live keys are refused
STRIPE_SECRET_KEY=
