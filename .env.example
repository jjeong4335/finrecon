# Copy to .env and fill in. Never commit .env.

# --- Mode -----------------------------------------------------------------
MODE=offline                 # offline (no credentials) | live (sandboxes)
RECON_AS_OF=2026-11-30       # frozen reconciliation date for the public demo
FIRST_RUN_AS_OF=2026-11-25
SYNC_DELAY_DAYS=2
CANDIDATE_DATE_TOLERANCE_DAYS=3
STALE_AFTER_DAYS=2
# FIXTURE_DIR=fixtures/live_snapshot   # serve a captured sandbox snapshot offline
GITHUB_URL=https://github.com/jjeong4335/finrecon

# --- Docker / PostgreSQL ----------------------------------------------------
POSTGRES_PASSWORD=change-me-owner
DASHBOARD_DB_PASSWORD=change-me-readonly
DOMAIN=demo.example.com      # a DNS name pointing at the EC2 instance (":80" for plain HTTP)

# --- Live mode only -----------------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_TOKEN_FILE=.secrets/qbo_tokens.json   # {"refresh_token": "..."}; rotated tokens are written back
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
STRIPE_SECRET_KEY=sk_test_...             # test keys only; live keys are refused
